# === LLM ===
GROQ_API_KEY=your_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile

# === Database ===
# Local Docker Postgres (Phase 0). Swapped for Neon URL at deploy (Phase 9).
DATABASE_URL=postgresql://revenueos:revenueos@localhost:5433/revenueos

# === App ===
APP_ENV=local
DEFAULT_TENANT_ID=demo-practice-001

# === Mock services (internal docker network URLs) ===
MOCK_ELIGIBILITY_URL=http://mock-eligibility:8001
MOCK_CLEARINGHOUSE_URL=http://mock-clearinghouse:8002
MOCK_PAYER_URL=http://mock-payer:8003
